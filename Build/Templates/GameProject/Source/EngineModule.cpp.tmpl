#include <Engine.h>

{{ENGINE_INCLUDES}}

using FEnabledEngineExtensions = {{ENGINE_EXTENSIONS}};

// ── Engine aggregate (parallel drive, EEngineStage). ──
class {{APP_CLASS}} final
	: public Maho::FEngineBase
	, public FEnabledEngineExtensions
{
public:
	{{APP_CLASS}}() = default;

protected:
	void ParseCommandLine(int Argc, char** Argv) override
	{
		(void)Argc;
		(void)Argv;
	}

public:
	bool ExecuteStage(Maho::EEngineStage Stage) override
	{
		switch (Stage)
		{
		case Maho::EEngineStage::PreInit:      Execute<Maho::EEngineStage::PreInit, FList>(); break;
		case Maho::EEngineStage::Init:         Execute<Maho::EEngineStage::Init, FList>(); break;
		case Maho::EEngineStage::PostInit:     Execute<Maho::EEngineStage::PostInit, FList>(); break;
		case Maho::EEngineStage::PreTick:      Execute<Maho::EEngineStage::PreTick, FList>(); break;
		case Maho::EEngineStage::Tick:         Execute<Maho::EEngineStage::Tick, FList>(); break;
		case Maho::EEngineStage::PostTick:     Execute<Maho::EEngineStage::PostTick, FList>(); break;
		case Maho::EEngineStage::PreShutdown:  Execute<Maho::EEngineStage::PreShutdown, FList, Maho::FReverseTopology>(); break;
		case Maho::EEngineStage::Shutdown:     Execute<Maho::EEngineStage::Shutdown, FList, Maho::FReverseTopology>(); break;
		case Maho::EEngineStage::PostShutdown: Execute<Maho::EEngineStage::PostShutdown, FList, Maho::FReverseTopology>(); break;
		}
		return true;
	}
};

extern "C" Maho::IExtension<Maho::EEngineStage>* CreateEngine()
{
	return new {{APP_CLASS}}();
}
