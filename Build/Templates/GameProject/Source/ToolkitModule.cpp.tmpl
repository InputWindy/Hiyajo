#include <Toolkit.h>

{{TOOL_INCLUDES}}

using FEnabledToolExtensions = {{TOOL_EXTENSIONS}};

// ── Pre-app toolkit aggregate (serial drive, EToolStage). ──
class {{TOOLKIT_CLASS}} final
	: public Maho::FToolkitBase
	, public FEnabledToolExtensions
{
public:
	{{TOOLKIT_CLASS}}() = default;

protected:
	void ParseCommandLine(int Argc, char** Argv) override
	{
		(void)Argc;
		(void)Argv;
	}

public:
	bool ExecuteStage(Maho::EToolStage Stage) override
	{
		if (Stage == Maho::EToolStage::Init)
		{
			Execute<Maho::EToolStage::Init, FList>();
		}
		else
		{
			Execute<Maho::EToolStage::Shutdown, FList, Maho::FReverseTopology>();
		}
		return true;
	}
};

extern "C" Maho::IExtension<Maho::EToolStage>* CreateTool()
{
	return new {{TOOLKIT_CLASS}}();
}
