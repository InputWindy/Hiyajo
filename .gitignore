# UE-style generated / local dirs (fully disposable; recreate on generate/build)
/Intermediate/
/Maho/Intermediate/
/Binaries/
/Packaged/
/Cached/
/Saved/

# Logs (runtime + accidental CMake/configure leftovers)
*.log
/CMakeFiles/

# Generated beside .cproject / workspace
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# Local CMake / IDE
# Do NOT ignore "build/" — on Windows (case-insensitive) it also hides tracked /Build tooling.
/out/
/cmake-build-*/
/.vs/
/.vscode/
/.cursor/
CMakeUserPresets.json
compile_commands.json
__pycache__/
*.py[cod]
*$py.class

# Engine-local Python — installed by setup.bat; users must run setup themselves.
# Never commit the interpreter, its installer cache, or pip/download leftovers.
/Tools/python/
/Tools/_cache/
/Tools/**/__pycache__/
/Tools/AgentBridge/node_modules/
/Tools/AgentBridge/.runtime/
/Tools/AgentBridge/.env
/Tools/AgentBridge/.env.local
!/Tools/AgentBridge/.env.example

# Object / binary artifacts
*.d
*.slo
*.lo
*.o
*.obj
*.gch
*.pch
*.ilk
*.pdb
*.so
*.dylib
*.dll
*.mod
*.smod
*.lai
*.la
*.a
*.lib
*.exe
*.out
*.app
*.dwo

# Reflect / Lua codegen (Tools/reflect_codegen.py).
# All C++/JSON outputs live under Maho/Source/Generated/ — wiped by clean.bat.
*.gen.h
*.gen.cpp
*.gen.json
/Maho/Source/Generated/
