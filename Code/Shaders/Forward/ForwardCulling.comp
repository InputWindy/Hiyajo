#version 450
#extension GL_ARB_separate_shader_objects : enable

// GPU-driven culling: one invocation per instance.
// Frustum-culls the instance and writes a DrawIndexedIndirect command
// for visible instances (empty commands are pre-filled by CPU).

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform CullParams
{
	vec4 FrustumPlanes[6];
	uint InstanceCount;
	uint Pad0;
	uint Pad1;
	uint Pad2;
} PC;

struct Instance
{
	mat4 LocalToWorld;
	vec4 Color;
};

layout(set = 0, binding = 0, std430) readonly buffer SceneInstances
{
	Instance Instances[];
};

struct DrawArgs
{
	uint IndexCount;
	uint InstanceCount;
	uint FirstIndex;
	int  VertexOffset;
	uint FirstInstance;
};

layout(set = 0, binding = 1, std430) writeonly buffer IndirectArgs
{
	DrawArgs Commands[];
};

void main()
{
	uint i = gl_GlobalInvocationID.x;
	if (i >= PC.InstanceCount)
	{
		return;
	}

	Instance inst = Instances[i];
	vec3 center = inst.LocalToWorld[3].xyz;

	// Unit-cube AABB: radius ~0.866 (half diagonal). Use 1.0 for a conservative bound.
	const float Radius = 1.0;
	bool visible = true;
	for (int p = 0; p < 6; ++p)
	{
		vec4 plane = PC.FrustumPlanes[p];
		float d = dot(plane.xyz, center) + plane.w;
		if (d < -Radius)
		{
			// TEMP: culling disabled for debug.
			// visible = false;
			break;
		}
	}

	if (visible)
	{
		DrawArgs args;
		args.IndexCount = 36;      // unit cube
		args.InstanceCount = 1;
		args.FirstIndex = 0;
		args.VertexOffset = 0;
		args.FirstInstance = i;
		Commands[i] = args;
	}
}
